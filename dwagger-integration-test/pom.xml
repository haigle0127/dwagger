<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>dwagger-integration-test</artifactId>
    <version>1.0.0</version>
    <name>dwagger-integration-test</name>
    <description>Dwagger Starter 集成测试工程（Spring Boot 4.1.x / jakarta）</description>

    <properties>
        <java.version>17</java.version>
        <dwagger.version>0.0.1</dwagger.version>
        <!-- Boot 4.1.1 默认 Logback 1.5.38，抬到 1.6.5 修复 CVE-2026-19880 / CVE-2026-104721 -->
        <logback.version>1.6.5</logback.version>
        <slf4j.version>2.0.20</slf4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Dwagger Spring Boot 4.x Starter（jakarta，内含 springdoc-openapi-starter-webmvc-ui 3.1.1 与 UI 静态资源） -->
        <dependency>
            <groupId>cn.haigle.dwagger</groupId>
            <artifactId>dwagger-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${dwagger.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
