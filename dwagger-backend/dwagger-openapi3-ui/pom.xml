<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>dwagger</artifactId>
        <groupId>cn.haigle.dwagger</groupId>
        <version>0.0.5</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>dwagger-openapi3-ui</artifactId>
    <name>dwagger-openapi3-ui</name>
    <description>springdoc-openapi的Ui模块</description>
    <properties>
        <!-- 前端工程目录，产物不入库，构建时从这里取 dist -->
        <dwagger-ui.dir>${project.basedir}/../../dwagger-ui</dwagger-ui.dir>
        <!-- 只改后端时可跳过前端构建，需本地已有 dist -->
        <dwagger-skip-ui-build>false</dwagger-skip-ui-build>
    </properties>

    <build>
        <resources>
            <!-- 直接把前端产物打进 META-INF/resources，不再回填源码目录 -->
            <resource>
                <directory>${dwagger-ui.dir}/dist</directory>
                <targetPath>META-INF/resources/</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>pnpm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${dwagger-skip-ui-build}</skip>
                            <workingDirectory>${dwagger-ui.dir}</workingDirectory>
                            <executable>pnpm</executable>
                            <arguments>
                                <argument>install</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${dwagger-skip-ui-build}</skip>
                            <workingDirectory>${dwagger-ui.dir}</workingDirectory>
                            <executable>pnpm</executable>
                            <arguments>
                                <argument>run</argument>
                                <argument>build:SpringDocOpenApi</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
